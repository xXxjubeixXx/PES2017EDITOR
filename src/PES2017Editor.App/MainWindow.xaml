<Window x:Class="PES2017Editor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PES2017Editor.App"
        Title="PES 2017 Database Editor"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        Background="{StaticResource BgBrush}">
    <Window.Resources>
        <local:StringEqualsVisibilityConverter x:Key="PageConverter" />
        <local:UnavailablePageVisibilityConverter x:Key="UnavailablePageConverter" />
        <local:BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Margin" Value="0,0,14,14" />
        </Style>
        <DataTemplate x:Key="NavigationTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Icon}" Width="28" FontSize="16" Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="EntryRowStyle" TargetType="DataGridRow">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" Background="{StaticResource SidebarBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="22,22,18,22">
                    <TextBlock Text="PES 2017" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="DATABASE EDITOR" FontSize="10" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="Fase 03 · Motor de dados" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ListBox ItemsSource="{Binding Navigation}" SelectedItem="{Binding SelectedNavigation, Mode=TwoWay}" ItemTemplate="{StaticResource NavigationTemplate}" Margin="10,0,10,10" />
                </ScrollViewer>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="18,14">
                    <StackPanel>
                        <TextBlock Text="MODO SEGURO · CÓPIA EXPERIMENTAL" FontSize="10" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="Originais preservados · edições somente em cópias experimentais." FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Background="{StaticResource BgBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <TextBlock Text="{Binding SelectedPage}" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="  /  PES 2017 Database Editor" FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                <Ellipse Width="8" Height="8" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0" />
                <TextBlock Text="Leitura segura" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                <TextBlock Text="  ·  " Foreground="{StaticResource BorderBrush}" FontSize="12" />
                <TextBlock Text="{Binding AppVersionText}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,24">
            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Visão geral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Visão geral" FontSize="28" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " FontSize="24" Foreground="{StaticResource BorderBrush}" Margin="8,0" />
                            <TextBlock Text="{Binding AppVersionText}" FontSize="18" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Carregue uma instalação para obter fatos verificados sobre os arquivos do jogo." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" />

                        <Border Style="{StaticResource CardStyle}" Padding="18,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="INSTALAÇÃO DO JOGO" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBox Text="{Binding SelectedPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" MinWidth="450" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Procurar" Command="{Binding BrowseCommand}" VerticalAlignment="Bottom" Margin="12,0,8,0" />
                                <Button Grid.Column="2" Content="Carregar jogo" Command="{Binding LoadCommand}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Visibility="{Binding IsLoading, Converter={StaticResource BooleanVisibility}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Content="Cancelar" Command="{Binding CancelCommand}" HorizontalAlignment="Right" />
                                </Grid>
                                <ProgressBar Height="8" Margin="0,14,0,0" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource BorderBrush}" />
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4" Margin="0,0,0,2">
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="CPKs detectados" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Text="{Binding CpkCountText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Arquivos indexados" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Text="{Binding IndexedCountText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Tamanho total" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Text="{Binding TotalSizeText}" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,0" /></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Compatibilidade" Foreground="{StaticResource MutedBrush}" FontSize="12" /><TextBlock Text="{Binding CompatibilityText}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" /></StackPanel></Border>
                        </UniformGrid>

                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="INSTALAÇÃO IDENTIFICADA" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Installation.RootPath, TargetNullValue=Não carregada}" Margin="0,10,0,0" TextWrapping="Wrap" />
                                    <TextBlock Text="Executável" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                                    <TextBlock Text="{Binding Installation.ExecutableVersion, TargetNullValue=Não identificado}" />
                                    <TextBlock Text="Data Pack" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,0" />
                                    <TextBlock Text="Não identificado nesta fase" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <TextBlock Text="RECENTES" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                    <ListBox ItemsSource="{Binding RecentInstallations}" Margin="0,8,0,0" MaxHeight="160">
                                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" /></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="As instalações recentes são apenas atalhos locais; nada é alterado nelas automaticamente." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,14,20">
                            <StackPanel>
                                <TextBlock Text="PROBLEMAS E LIMITAÇÕES" FontSize="11" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Issues}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="•  {Binding Message}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Nenhuma contagem de jogadores, times, ligas ou competições é inventada: elas permanecem não identificadas até que os BINs correspondentes tenham parser comprovado." Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,14,20">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO DE INICIALIZAÇÃO" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Os logs ajudam a investigar falhas de abertura sem alterar os dados do usuário." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,8" />
                                <TextBlock Text="{Binding StartupLogPathText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Abrir pasta de logs" Command="{Binding OpenLogsCommand}" />
                                    <Button Content="Copiar caminho" Command="{Binding CopyLogPathCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Arquivos CPK}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Explorador de arquivos CPK" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Índice virtual · extração individual · leitura técnica" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Bottom" ToolTip="Pesquisar por caminho interno" />
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="300" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0">
                        <ListBox ItemsSource="{Binding Archives}" DisplayMemberPath="Name" />
                    </Border>
                    <DataGrid Grid.Column="1" ItemsSource="{Binding Entries}" RowStyle="{StaticResource EntryRowStyle}" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CPK" Binding="{Binding ArchiveName}" Width="140" />
                            <DataGridTextColumn Header="Caminho interno" Binding="{Binding InternalPath}" Width="*" />
                            <DataGridTextColumn Header="Armazenado" Binding="{Binding StoredSize}" Width="100" />
                            <DataGridTextColumn Header="Original" Binding="{Binding OriginalSize}" Width="100" />
                            <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" Width="60" />
                            <DataGridTemplateColumn Header="Ação" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Extrair" Command="{Binding DataContext.ExtractCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" Margin="4,2" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Jogadores}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Editor de jogadores" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Dados reais de Player.bin · nome editável em cópia experimental" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,18,14,14" Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PlayerFilterText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Pesquisar por ID, nome, nome na camisa ou time" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Jogadores: " Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding PlayerCountText}" FontWeight="SemiBold" />
                            <TextBlock Text="  ·  " Foreground="{StaticResource BorderBrush}" />
                            <TextBlock Text="{Binding DatabaseStatus}" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Players}" IsReadOnly="False" CanUserSortColumns="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Margin="0,0,14,0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsVisible}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="90" />
                        <DataGridTextColumn Header="Nome" Binding="{Binding EditedName, UpdateSourceTrigger=LostFocus}" Width="*" />
                        <DataGridTextColumn Header="Nome na camisa" Binding="{Binding ShirtName}" IsReadOnly="True" Width="150" />
                        <DataGridTextColumn Header="Time ID" Binding="{Binding TeamId}" IsReadOnly="True" Width="90" />
                        <DataGridTextColumn Header="Time" Binding="{Binding TeamName}" IsReadOnly="True" Width="180" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding State}" IsReadOnly="True" Width="90" />
                        <DataGridTemplateColumn Header="Ação" Width="190">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Aplicar" Command="{Binding DataContext.SavePlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" Margin="2" />
                                        <Button Content="Descartar" Command="{Binding DataContext.DiscardPlayerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="8,4" Margin="2" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Times}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Editor de times" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Registros reais identificados em Team.bin; campos ainda somente leitura." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14"><TextBlock Text="Times identificados: " Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding TeamCountText}" Foreground="{StaticResource TextBrush}" /></StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Teams}" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="90" />
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="120" />
                        <DataGridTextColumn Header="Nome observado" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Evidência" Binding="{Binding Evidence}" Width="170" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Competições}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Competições identificadas" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Competition.bin · nomes observados sem promover hipóteses a campos editáveis" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,18,0,14"><TextBlock Text="Competições identificadas: " Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding CompetitionCountText}" Foreground="{StaticResource TextBrush}" /></StackPanel>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Competitions}" IsReadOnly="True" CanUserSortColumns="True" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Margin="0,0,14,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Índice" Binding="{Binding Index}" Width="90" />
                        <DataGridTextColumn Header="Nome observado" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Evidência" Binding="{Binding Evidence}" Width="190" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Configurações}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Configurações" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Preferências locais e atualizações do aplicativo" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" />

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="ATUALIZAÇÕES" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                <CheckBox Content="Verificar atualizações automaticamente ao iniciar" IsChecked="{Binding AutoCheckForUpdates}" Foreground="{StaticResource TextBrush}" Margin="0,14,0,12" />
                                <TextBlock Text="{Binding UpdateStatus}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding UpdateProgress, Mode=OneWay}" Foreground="{StaticResource PrimaryBrush}" Background="{StaticResource BorderBrush}" Margin="0,12,0,12" Visibility="{Binding IsUpdating, Converter={StaticResource BooleanVisibility}}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Verificar atualizações" Command="{Binding CheckUpdatesCommand}" />
                                    <Button Content="Atualizar agora" Command="{Binding UpdateNowCommand}" Style="{StaticResource PrimaryButton}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanVisibility}}" />
                                    <Button Content="Abrir releases" Command="{Binding OpenRepositoryCommand}" CommandParameter="https://github.com/xXxjubeixXx/PES2017EDITOR/releases" />
                                </StackPanel>
                                <TextBlock Text="Versão disponível" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                                <TextBlock Text="{Binding LatestVersionText}" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Tamanho do instalador" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding LatestInstallerSizeText}" />
                                <TextBlock Text="{Binding LatestReleaseNotes}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="140" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="DADOS LOCAIS" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="Configurações e cache" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                                <TextBlock Text="%LOCALAPPDATA%\PES2017EDITOR" />
                                <TextBlock Text="Backups" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4" />
                                <TextBox Text="{Binding BackupsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Projetos experimentais" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding ProjectsDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Arquivos grandes" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
                                <TextBox Text="{Binding LargeFilesDirectory, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding SelectedPage, Converter={StaticResource PageConverter}, ConverterParameter=Sobre}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Sobre" FontSize="28" FontWeight="SemiBold" />
                        <TextBlock Text="Identidade, versão e informações de distribuição" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="PES 2017 DATABASE EDITOR" FontSize="12" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding AppVersionText}" FontSize="30" FontWeight="SemiBold" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding BuildInformationText}" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                                <TextBlock Text="Editor independente para investigação e edição futura dos dados do PES 2017." TextWrapping="Wrap" Margin="0,18,0,0" />
                                <TextBlock Text="Este projeto não possui vínculo oficial com a Konami." Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                    <Button Content="Repositório oficial" Command="{Binding OpenRepositoryCommand}" CommandParameter="https://github.com/xXxjubeixXx/PES2017EDITOR" />
                                    <Button Content="Reportar problema" Command="{Binding OpenRepositoryCommand}" CommandParameter="https://github.com/xXxjubeixXx/PES2017EDITOR/issues" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="LICENÇAS" FontSize="11" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" />
                                <TextBlock Text="As licenças das dependências e as limitações de redistribuição estão documentadas no repositório. Nenhum arquivo proprietário do jogo ou DLL externa do CPK Tool é distribuído." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Background="#18202B" CornerRadius="8" Padding="22" Visibility="{Binding SelectedPage, Converter={StaticResource UnavailablePageConverter}, ConverterParameter=Visão geral;Arquivos CPK;Jogadores;Times;Competições;Configurações;Sobre}">
                <StackPanel>
                    <TextBlock Text="Área preparada para a próxima etapa" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Esta seção já está incluída na navegação, mas ainda não possui interpretação comprovada nesta fase." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <TextBlock Text="Nenhum dado fictício é exibido. O próximo parser será conectado ao mesmo núcleo independente da interface." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
