<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PES2017Editor.Database</AssemblyName>
    <RootNamespace>PES2017Editor.Database</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Microsoft.Data.Sqlite 10.0.0 resolves 2.1.11 transitively; pin the native SQLite
         package to the maintained 2.1.14 line so the vulnerable native dependency is not used. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.14" />
    <ProjectReference Include="..\PES2017Editor.Cpk\PES2017Editor.Cpk.csproj" />
    <ProjectReference Include="..\PES2017Editor.Binary\PES2017Editor.Binary.csproj" />
  </ItemGroup>
</Project>
