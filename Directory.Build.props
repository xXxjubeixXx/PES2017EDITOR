<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <VersionPrefix>0.3.1</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <Product>PES 2017 Database Editor</Product>
    <Company>PES 2017 Database Editor Contributors</Company>
    <Copyright>Copyright 2026 PES 2017 Database Editor Contributors</Copyright>
    <RepositoryUrl>https://github.com/xXxjubeixXx/PES2017EDITOR</RepositoryUrl>
    <BuildDate Condition="'$(BuildDate)' == ''">not specified</BuildDate>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildDate" Value="$(BuildDate)" />
  </ItemGroup>
</Project>
